const CONFIG = {
  RECIPIENT_EMAIL: "jontorapadang35@gmail.com",
  SENDER_NAME: "Manufacturing Technology-I Assessment"
};

function doGet() {
  return HtmlService.createHtmlOutput(
    "<h2>Manufacturing Technology-I report service</h2><p>Backend is deployed. Open the GitHub Pages assessment page to submit a test report.</p>"
  ).setTitle("MT1 Assessment Backend");
}

/**
 * Receives a form POST from the GitHub Pages static website.
 * The HTML form sends a field named "payload" containing JSON.
 */
function doPost(e) {
  try {
    if (!e || !e.parameter || !e.parameter.payload) {
      throw new Error("Missing submission payload.");
    }
    const payload = JSON.parse(e.parameter.payload);
    const result = submitAssessmentReport_(payload);
    return HtmlService.createHtmlOutput(
      "<!doctype html><html><body><p>Assessment report processed. You may close this frame.</p></body></html>"
    );
  } catch (err) {
    console.error(err && err.stack ? err.stack : err);
    return HtmlService.createHtmlOutput(
      "<!doctype html><html><body><p>Report processing failed. Check Apps Script Executions for details.</p></body></html>"
    );
  }
}

/**
 * Optional direct test function; the GitHub page uses doPost().
 */
function submitAssessmentReport(payload) {
  return submitAssessmentReport_(payload);
}

function submitAssessmentReport_(payload) {
  validatePayload_(payload);
  const student = payload.student || {};
  const safeRoll = String(student.roll || "unknown").replace(/[^a-zA-Z0-9_-]/g, "_");
  const submitted = payload.submittedAt ? new Date(payload.submittedAt) : new Date();
  const warnings = Array.isArray(payload.warnings) ? payload.warnings : [];
  const pdf = Utilities.newBlob(buildReportHtml_(payload, submitted), "text/html", "assessment-report.html")
    .getAs("application/pdf")
    .setName("MT1_Assessment_" + safeRoll + ".pdf");

  const subject = "Manufacturing Technology-I Assessment Report - " +
    String(student.name || "Student") + " (" + String(student.roll || "No roll") + ")";
  const body = [
    "Dear Class Teacher,",
    "",
    "Attached is the automatically generated assessment report.",
    "Student: " + String(student.name || ""),
    "Roll number: " + String(student.roll || ""),
    "Score: " + Number(payload.score || 0) + " / " + Number(payload.maxScore || 20),
    "Course Outcome: CO5 | Instructional Learning Outcome: ILO9",
    "Submitted: " + submitted.toLocaleString(),
    "Integrity warnings recorded: " + warnings.length,
    "",
    "This report was generated by the assessment web app. Please verify the record as required."
  ].join("\n");

  MailApp.sendEmail({
    to: CONFIG.RECIPIENT_EMAIL,
    subject: subject,
    body: body,
    name: CONFIG.SENDER_NAME,
    attachments: [pdf]
  });
  return "PDF report emailed successfully to " + CONFIG.RECIPIENT_EMAIL + ".";
}

function validatePayload_(payload) {
  if (!payload || typeof payload !== "object") throw new Error("Missing submission data.");
  const student = payload.student || {};
  if (!String(student.name || "").trim()) throw new Error("Student name is missing.");
  if (!String(student.roll || "").trim()) throw new Error("Student roll number is missing.");
  if (!Array.isArray(payload.responses)) throw new Error("Response data is missing.");
  if (payload.responses.length > 100) throw new Error("Unexpected number of responses.");
  if (Number(payload.score) < 0 || Number(payload.score) > 20) throw new Error("Invalid score.");
}

function buildReportHtml_(payload, submitted) {
  const s = payload.student || {};
  const score = Number(payload.score || 0);
  const max = Number(payload.maxScore || 20);
  const responses = payload.responses || [];
  const warnings = payload.warnings || [];
  const started = payload.startedAt ? new Date(payload.startedAt) : null;
  const elapsed = Number(payload.elapsedSeconds || 0);

  const responseRows = responses.map(r => `
    <tr>
      <td>${escapeHtml_(r.number)}</td>
      <td>${escapeHtml_(r.topic)}<br><small>${escapeHtml_(r.type)}</small></td>
      <td>${escapeHtml_(r.question)}</td>
      <td>${escapeHtml_(r.response)}</td>
      <td>${escapeHtml_(r.correctAnswer)}</td>
      <td>${Number(r.marks) === 1 ? "1" : "0"} / 1</td>
    </tr>`).join("");

  const warningRows = warnings.length ? warnings.map(w => `
    <tr><td>${escapeHtml_(w.time || "")}</td><td>${escapeHtml_(w.event || "")}</td></tr>
  `).join("") : '<tr><td colspan="2">No browser integrity warnings were recorded.</td></tr>';

  return `<!doctype html><html><head><meta charset="utf-8">
    <style>
      body{font-family:Arial,sans-serif;color:#1d2b36;font-size:10px;margin:24px}
      h1{font-size:18px;color:#12304a;margin-bottom:4px}h2{font-size:13px;color:#12304a;margin-top:22px}
      p{margin:5px 0}.meta{background:#edf3f8;padding:8px;margin:10px 0}
      table{border-collapse:collapse;width:100%;margin-top:8px}
      th,td{border:1px solid #cbd5df;padding:5px;vertical-align:top;text-align:left}
      th{background:#edf3f8}small{color:#536575}
      .signatures{margin-top:35px;width:100%}.signatures td{height:55px;border:0;padding:5px 20px 0 0}
      .line{border-bottom:1px solid #263746;height:35px}.note{font-size:8px;color:#536575;margin-top:20px}
    </style></head><body>
    <h1>Assessment Submission Report</h1>
    <p><b>Manufacturing Technology-I — Non-Traditional Machining Processes</b></p>
    <div class="meta"><b>CO5</b> &nbsp; | &nbsp; <b>ILO9</b> &nbsp; | &nbsp; Maximum marks: ${max} &nbsp; | &nbsp; Duration: 45 minutes</div>
    <table>
      <tr><th>Student name</th><td>${escapeHtml_(s.name)}</td><th>Roll number</th><td>${escapeHtml_(s.roll)}</td></tr>
      <tr><th>Semester / Class</th><td>${escapeHtml_(s.semester)}</td><th>Branch / Section</th><td>${escapeHtml_(s.section || "—")}</td></tr>
      <tr><th>Score</th><td><b>${score} / ${max} (${max ? (score/max*100).toFixed(1) : "0.0"}%)</b></td><th>Status</th><td>${payload.autoSubmitted ? "Auto-submitted (time expired)" : "Submitted"}</td></tr>
      <tr><th>Started</th><td>${started ? escapeHtml_(started.toLocaleString()) : "—"}</td><th>Submitted</th><td>${escapeHtml_(submitted.toLocaleString())}</td></tr>
      <tr><th>Time used</th><td>${Math.floor(elapsed/60)} min ${elapsed%60} sec</td><th>Integrity warnings</th><td>${warnings.length}</td></tr>
    </table>
    <h2>Response details</h2>
    <table><thead><tr><th>#</th><th>Topic / Type</th><th>Question</th><th>Student response</th><th>Correct answer</th><th>Marks</th></tr></thead>
    <tbody>${responseRows}</tbody></table>
    <h2>Integrity log</h2><table><tr><th>Time</th><th>Event</th></tr>${warningRows}</table>
    <table class="signatures"><tr>
      <td style="width:50%"><div class="line"></div><b>Student Signature</b></td>
      <td style="width:50%"><div class="line"></div><b>Class Teacher's Signature</b></td>
    </tr></table>
    <p class="note">Generated by the assessment web app. This is a browser-submitted record and should be verified by the class teacher. Browser integrity warnings are not tamper-proof proctoring.</p>
    </body></html>`;
}

function escapeHtml_(value) {
  return String(value == null ? "" : value)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}
